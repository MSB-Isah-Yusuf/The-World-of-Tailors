+/* ================= DARK THEME PLATFORM-WIDE — white → midnight mapping ================= */
+/* Every explicit bg-white surface becomes a subtle dark elevation — cards themselves are already --card (midnight 14%) */
+.dark .bg-white {
+  background-color: rgba(255,255,255,0.06) !important;
+  border-color: rgba(255,255,255,0.10) !important;
+  color: #F8F4EC !important;
+}
+.dark .bg-white\/90 { background-color: rgba(16,24,43,0.78) !important; border-color: rgba(255,255,255,0.10) !important; }
+.dark .bg-white\/85, .dark .bg-white\/80 { background-color: rgba(16,24,43,0.72) !important; }
+/* Page shells that were ivory/cream should match page background (midnight) so Cards pop */
+.dark .bg-ivory,
+.dark .bg-\[\#FFFBF0\],
+.dark .bg-\[\#FFFBF0\].min-h-screen,
+.dark .bg-ivory.min-h-screen {
+  background-color: hsl(var(--background)) !important;
