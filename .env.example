# PostgreSQL — current Prisma schema supports PostgreSQL only.
# Use an isolated local database for development and a separate DB per deployment environment.
DATABASE_URL="postgresql://user:password@localhost:5432/twt?schema=public"
# `npm run db:push`, `db:reset`, and demo seed helpers additionally require explicit local-only confirmation flags.

# Auth — generate a UNIQUE value for each environment; never copy an example secret.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Production settings. Demo access is hard-disabled when NODE_ENV=production.
APP_ENV="development"
DEMO_MODE="false"

STORAGE_PROVIDER="local"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
CLOUDINARY_URL=""

EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.invalid"

NEXT_PUBLIC_MAPBOX_TOKEN=""

# Paystack server-side integration. Start with test-mode credentials for approved tests.
# Live keys are not launch approval; enable only after the documented rollout gates pass.
PAYMENT_ENVIRONMENT="test"
# Only set true on an approved production-like staging environment using sk_test_/pk_test_ keys.
PAYMENT_TEST_MODE_ENABLED="false"
# All three gates must be explicitly enabled for live mutations; keep false until foundation acceptance and separate approvals.
PAYMENT_FINANCIAL_FOUNDATION_APPROVED="false"
PAYMENT_LIVE_ENABLED="false"
PAYMENT_LIVE_APPROVED="false"
PAYMENT_DEFAULT_CURRENCY="NGN"
PAYSTACK_BASE_URL="https://api.paystack.co"
PAYSTACK_CALLBACK_URL="http://localhost:3000/payments/return"
PAYSTACK_SECRET_KEY="sk_test_replace_me"
PAYSTACK_PUBLIC_KEY="pk_test_replace_me"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_replace_me"
# Current dashboard webhook signing secret (whsec_...). Legacy x-paystack-signature remains supported during rotation.
PAYSTACK_WEBHOOK_SIGNING_SECRET=""
PAYMENT_PROCESSING_FEE_POLICY="PLATFORM" # PLATFORM | SELLER | SHARED
PAYMENT_SHARED_FEE_PLATFORM_BPS="" # required for SHARED; 0–10000 is platform share of actual processor fee
PAYMENT_FABRIC_DELIVERY_FEE_MINOR="" # required explicit per-seller delivery fee in kobo
PAYMENT_IMMEDIATE_SPLIT_ENABLED="false"
PAYMENT_CONTROLLED_PAYOUTS_APPROVED="false"
PAYMENT_CONTROLLED_PAYOUTS_ENABLED="false"
PAYOUT_APPROVAL_MODE="MANUAL"
CRON_SECRET=""

SENTRY_DSN=""
