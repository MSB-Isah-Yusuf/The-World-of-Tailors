# Database — dev uses SQLite (file:./dev.db), prod must be PostgreSQL
DATABASE_URL="file:./dev.db"
# For production Postgres: DATABASE_URL="postgresql://user:password@host:5432/twt?sslmode=require&schema=public"

# Auth — REQUIRED on Vercel (fix MissingSecret error)
# Generate: openssl rand -base64 32   or   npx auth secret
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# For prod: AUTH_URL="https://your-domain.vercel.app"

# Demo mode
APP_ENV="development"
DEMO_MODE="true"
# For prod: APP_ENV="production" and DEMO_MODE="false"

# Object storage
STORAGE_PROVIDER="local"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="twt-uploads"
CLOUDINARY_URL=""

# Email
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="noreply@twt.ng"

# Maps
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Payments (Paystack Nigeria)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Monitoring
SENTRY_DSN=""
