# Database — PRODUCTION must be PostgreSQL (Vercel)
# DATABASE_URL must start with postgresql:// when provider=postgresql
DATABASE_URL="postgresql://user:password@localhost:5432/twt?schema=public"
# For local dev without Postgres you can temporarily switch prisma provider back to sqlite and use:
# DATABASE_URL="file:./dev.db"
# But Vercel requires postgresql:// — set it in Vercel Env Vars to your Neon/Supabase URL

# Auth — REQUIRED on Vercel (fixes MissingSecret)
# Generate: openssl rand -base64 32   or   npx auth secret
AUTH_SECRET="generate-with-openssl-rand-base64-32-min-32-chars"
AUTH_URL="http://localhost:3000"
# For prod: AUTH_URL="https://your-domain.vercel.app"

APP_ENV="development"
DEMO_MODE="true"
# For prod: APP_ENV="production" DEMO_MODE="false"

STORAGE_PROVIDER="local"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="twt-uploads"
CLOUDINARY_URL=""

EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="noreply@twt.ng"

NEXT_PUBLIC_MAPBOX_TOKEN=""

PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

SENTRY_DSN=""
