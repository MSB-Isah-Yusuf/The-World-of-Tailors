# Database
DATABASE_URL="postgresql://user:password@localhost:5432/twt?schema=public"
# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Demo mode
APP_ENV="development"
DEMO_MODE="true"
# Object storage (S3 compatible or Cloudinary)
STORAGE_PROVIDER="local"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="twt-uploads"
CLOUDINARY_URL=""
# Email (e.g. Resend, SendGrid)
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="noreply@twt.ng"
# Maps (Mapbox / Google)
NEXT_PUBLIC_MAPBOX_TOKEN=""
# Payments (Paystack for Nigeria)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
# Monitoring
SENTRY_DSN=""
